<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 이상은 시스템 시작 화면을 씁니다. 아이콘(네모·동그라미 테두리) 대신
         파란 바탕 가운데 발자국만 보이게 하고, 앱 첫 화면과 같은 위치·크기로 이어지게 합니다. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_blue</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
